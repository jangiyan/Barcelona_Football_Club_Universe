# Git ignore for Barça Universe — static HTML/CSS website

# Operating system files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Editor/IDE directories
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~

# Log files
*.log
npm-debug.log*

# No node_modules, build output, or package files
